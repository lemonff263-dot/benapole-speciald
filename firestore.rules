rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOrder(data) {
      return data is map &&
        data.id is string && data.id.size() <= 64 &&
        data.customerName is string && data.customerName.size() <= 150 &&
        data.customerPhone is string && data.customerPhone.size() <= 30 &&
        data.orderMode in ['delivery', 'pickup'] &&
        data.total is number && data.total >= 0 &&
        data.status in ['received', 'confirmed', 'preparing', 'ready_or_out', 'completed', 'cancelled'] &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidConfig(data) {
      return data is map;
    }

    function isValidReview(data) {
      return data is map &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() <= 120 &&
        data.comment is string && data.comment.size() <= 600 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isValidId(orderId);
    }

    // Config Collection (Menu, Settings, Theme, Admin Auth)
    match /config/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create, update: if isValidId(docId) && isValidConfig(incoming());
      allow delete: if isValidId(docId);
    }

    // Customer Reviews Collection
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isValidId(reviewId);
    }
  }
}
